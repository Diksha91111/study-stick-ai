PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/studystick_ai
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
MAIL_FROM="Study Stick AI" <noreply@studystick.ai>

# AI Provider Configuration (Backend Only)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

AI_PRIMARY_PROVIDER=gemini
AI_FAST_PROVIDER=gemini
AI_REASONING_PROVIDER=openai
AI_CODING_PROVIDER=anthropic
AI_VISION_PROVIDER=gemini

AI_MAX_TOKENS=2048
AI_TIMEOUT_MS=30000

# WhatsApp Provider Configuration (Twilio / Official Provider API)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Scheduler Security (Optional webhook protection)
SCHEDULER_SECRET=

